# 输入/输出目录，可用相对路径或绝对路径
INPUT_DIR=input
OUTPUT_DIR=output

# 豆包/火山图像编辑配置
# 如果你使用火山 Ark / 豆包 OpenAI 兼容接口，通常这里填控制台创建的 API Key。
# 按你的要求变量名保留为 VOLC_ACCESSKEY，脚本会作为 Bearer Token 使用。
VOLC_ACCESSKEY=你的火山或豆包API_KEY
VOLC_IMAGE_EDIT_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
VOLC_IMAGE_EDIT_MODEL=doubao-seededit-3-0-i2i-250628
VOLC_RESPONSE_FORMAT=b64_json

# xAI Grok 兜底配置
XAI_API_KEY=你的xAI_API_KEY
XAI_IMAGE_EDIT_ENDPOINT=https://api.x.ai/v1/images/edits
XAI_IMAGE_EDIT_MODEL=grok-2-image
XAI_RESPONSE_FORMAT=b64_json

# 并发与重试配置
CONCURRENCY=3
PROVIDER_CONCURRENCY=2
TIMEOUT_SECONDS=90
MAX_RETRIES=3
RETRY_BASE_DELAY=1.5
LOG_LEVEL=INFO

# 可选：自定义编辑提示词
EDIT_PROMPT=请移除图片中的画师水印、签名、logo、字幕、日期戳和多余文字。保持原始构图、人物、背景、色彩、画风和分辨率尽可能不变。不要添加任何新的文字、logo、边框、水印或平台标识。
